{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Родословная",
  "version": "1.1.0",
  "identifier": "ru.familyarchive.desktop",
  "build": {
    "beforeDevCommand": "node scripts/dev.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Родословная — семейный архив",
        "width": 1440,
        "height": 940,
        "minWidth": 920,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "compression": "zlib",
        "startMenuFolder": "Родословная"
      }
    }
  }
}
